---
const siteTitle = "بازفکر | Bazfekr";
const tagline = "چیزهای آشنا، از زاویه‌ای ناآشنا";
const description =
  "بازفکر؛ فضایی برای کاوش در اقتصاد، رفتار و تصمیم‌های انسانی؛ و چیزهای دیگری که آن‌گونه که فکر می‌کنیم نیستند.";
const siteUrl = "https://www.bazfekr.ir";

const categories = [
  {
    title: "اقتصاد",
    description: "مفاهیم اقتصادی؛ نه آن‌گونه که در کتاب‌های درسی می‌آموزیم، بلکه آن‌گونه که در زندگی واقعی تجربه می‌کنیم.",
    emoji: "📈",
  },
  {
    title: "رفتار انسانی",
    description: "چرا افراد تصمیم‌های عجیب می‌گیرند؟ چیزی که روان‌شناسی و علوم شناختی درباره‌ی ما فاش می‌کند.",
    emoji: "🧠",
  },
  {
    title: "تصمیم‌گیری",
    description: "هنر انتخابِ هوشمندانه؛ میان تورش‌های ذهنی، قیود واقعیت و رویاهای بلندمدت.",
    emoji: "🎯",
  },
  {
    title: "چیزهایی که… نیستند",
    description: "همان چیزهایی که «همه می‌دانند» ولی در واقع هیچ‌کس آن‌ها را نمی‌داند؛ یا دروغ‌های آشکاری را به‌عنوان حقیقت می‌پذیرند.",
    emoji: "🔍",
  },
];

const featuredPosts = [
  {
    badge: "رفتار انسانی",
    title: "چرا وقتی عصبانی می‌شویم، کارهایی می‌کنیم که خودمان هم باورمان نمی‌شود؟",
    excerpt:
      "راهنمایی برای شناخت خشم، تصمیم‌گیری در حالت هیجانی و جلوگیری از تصمیم‌هایی که فردا از آن‌ها پشیمان می‌شویم.",
    minutes: 11,
    href: "/articles/why-anger-surprises-us/",
  },
  {
    badge: "تصمیم‌گیری",
    title: "چرا با اینکه می‌دانیم باید رها کنیم، باز هم ادامه می‌دهیم؟",
    excerpt:
      "درباره خطای هزینه غرق‌شده، هزینه فرصت، ترس از ضرر و اینکه چطور بفهمیم باید ادامه بدهیم، تغییر مسیر بدهیم یا رها کنیم.",
    minutes: 18,
    href: "/articles/why-we-keep-going/",
  },
];
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={siteUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="بازفکر" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content="/logo.jpg" />
    <meta property="og:locale" content="fa_IR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/logo.jpg" />

    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.jpg" />

    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css"
      rel="stylesheet"
      type="text/css"
    />

    <style>
      :root {
        --paper: #fbf6e9;
        --paper-2: #f3ead3;
        --ink: #141413;
        --ink-soft: #2a2924;
        --muted: #6b685c;
        --line: #22211c;
        --accent: #f4b400;
        --accent-deep: #c78b00;
        --accent-soft: #fff3c6;
        --card: #fffdf6;
        --shadow: 0 1px 0 #000, 0 10px 30px -20px rgba(20, 20, 19, 0.35);
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
      }

      body {
        font-family:
          "Vazirmatn",
          system-ui,
          -apple-system,
          "Segoe UI",
          Roboto,
          sans-serif;
        background:
          radial-gradient(1200px 500px at 90% -10%, #fff3c633, transparent 60%),
          radial-gradient(900px 500px at -10% 100%, #f4b40022, transparent 60%),
          var(--paper);
        color: var(--ink);
        line-height: 1.8;
        font-feature-settings: "ss01", "ss02";
        min-height: 100vh;
      }

      .noise::after {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        background-image: radial-gradient(rgba(20, 20, 19, 0.06) 1px, transparent 1px);
        background-size: 3px 3px;
        opacity: 0.6;
        mix-blend-mode: multiply;
        z-index: 0;
      }

      .container {
        width: min(1120px, calc(100% - 2rem));
        margin: 0 auto;
        position: relative;
        z-index: 1;
      }

      /* ===== Header ===== */
      header.nav {
        position: sticky;
        top: 0;
        z-index: 20;
        backdrop-filter: blur(8px);
        background: rgba(251, 246, 233, 0.78);
        border-bottom: 1px dashed rgba(34, 33, 28, 0.18);
      }

      .nav-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 14px 0;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        color: var(--ink);
      }

      .brand-logo {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        object-fit: cover;
        border: 1.5px solid var(--ink);
        box-shadow: 2px 2px 0 var(--ink);
      }

      .brand-title {
        display: flex;
        flex-direction: column;
        line-height: 1.1;
        min-width: 0;
      }

      .brand-title strong {
        font-size: 1.15rem;
        font-weight: 800;
        letter-spacing: -0.01em;
      }

      .brand-title span {
        font-size: 0.78rem;
        color: var(--muted);
      }

      nav ul {
        list-style: none;
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0;
        padding: 0;
        flex-wrap: wrap;
      }

      nav a {
        display: inline-block;
        text-decoration: none;
        color: var(--ink-soft);
        font-weight: 600;
        padding: 8px 14px;
        border-radius: 999px;
        font-size: 0.95rem;
        transition: all 0.15s ease;
      }

      nav a:hover {
        background: var(--accent-soft);
        color: var(--ink);
      }

      nav a.cta {
        background: var(--ink);
        color: var(--paper);
        padding: 9px 16px;
        border: 1.5px solid var(--ink);
      }

      nav a.cta:hover {
        background: var(--accent-deep);
        border-color: var(--accent-deep);
        transform: translateY(-1px);
      }

      /* ===== Hero ===== */
      .hero {
        padding: 72px 0 56px;
        position: relative;
      }

      .hero-grid {
        display: grid;
        grid-template-columns: 1.15fr 0.85fr;
        align-items: center;
        gap: 56px;
      }

      .hero-grid > * {
        min-width: 0;
      }

      @media (max-width: 900px) {
        .hero-grid {
          grid-template-columns: 1fr;
          gap: 36px;
        }
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: var(--accent-soft);
        border: 1.5px solid var(--ink);
        color: var(--ink);
        padding: 6px 14px;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 700;
        box-shadow: 2px 2px 0 var(--ink);
      }

      .eyebrow::before {
        content: "✦";
        color: var(--accent-deep);
      }

      h1 {
        font-size: clamp(2.2rem, 4.5vw, 3.4rem);
        font-weight: 900;
        line-height: 1.15;
        margin: 20px 0 18px;
        letter-spacing: -0.02em;
      }

      h1 .accent {
        background:
          linear-gradient(180deg, transparent 65%, var(--accent) 65% 92%, transparent 92%);
        padding: 0 2px;
      }

      .tagline {
        font-size: clamp(1.05rem, 1.8vw, 1.35rem);
        font-weight: 700;
        color: var(--ink-soft);
        margin: 0 0 14px;
      }

      .lede {
        font-size: 1.02rem;
        color: var(--muted);
        max-width: 55ch;
        margin: 0 0 28px;
      }

      .hero-art {
        position: relative;
        display: flex;
        justify-content: center;
      }

      .hero-art .stamp {
        position: relative;
        width: min(380px, 85vw);
        aspect-ratio: 1 / 1;
      }

      .hero-art img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 50%;
        border: 2.5px solid var(--ink);
        box-shadow:
          6px 6px 0 var(--ink),
          0 20px 50px -20px rgba(0, 0, 0, 0.35);
        background: var(--paper-2);
      }

      .hero-art .dot {
        position: absolute;
        width: 46px;
        height: 46px;
        background: var(--accent);
        border: 1.5px solid var(--ink);
        border-radius: 50%;
        box-shadow: 3px 3px 0 var(--ink);
        display: grid;
        place-items: center;
        font-size: 1.1rem;
      }

      .hero-art .dot.d1 {
        top: 4%;
        right: 4%;
        animation: floatY 4s ease-in-out infinite;
      }

      .hero-art .dot.d2 {
        bottom: 6%;
        left: 4%;
        animation: floatY 5s ease-in-out infinite reverse;
      }

      .hero-art .sticker {
        position: absolute;
        padding: 8px 14px;
        background: var(--card);
        border: 1.5px solid var(--ink);
        border-radius: 12px;
        font-weight: 800;
        font-size: 0.82rem;
        box-shadow: 3px 3px 0 var(--ink);
        transform: rotate(-4deg);
        left: 6%;
        top: 14%;
      }

      @keyframes floatY {
        0%,
        100% {
          transform: translateY(0);
        }
        50% {
          transform: translateY(-10px);
        }
      }

      /* ===== Section shell ===== */
      section {
        padding: 56px 0;
        position: relative;
        z-index: 1;
      }

      .section-head {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
        flex-wrap: wrap;
      }

      .section-kicker {
        color: var(--accent-deep);
        font-weight: 800;
        font-size: 0.88rem;
        letter-spacing: 0.04em;
      }

      h2 {
        font-size: clamp(1.7rem, 3vw, 2.3rem);
        margin: 6px 0 0;
        font-weight: 900;
        letter-spacing: -0.01em;
      }

      .section-head p {
        margin: 0;
        color: var(--muted);
        max-width: 48ch;
      }

      /* ===== Categories ===== */
      .categories {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
      }

      @media (max-width: 900px) {
        .categories {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (max-width: 520px) {
        .categories {
          grid-template-columns: 1fr;
        }
      }

      .cat {
        background: var(--card);
        border: 1.5px solid var(--ink);
        border-radius: 18px;
        padding: 22px 20px;
        box-shadow: 4px 4px 0 var(--ink);
        transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
        position: relative;
        overflow: hidden;
      }

      .cat::before {
        content: "";
        position: absolute;
        inset: auto -20% -60% auto;
        width: 220px;
        height: 220px;
        background: radial-gradient(circle, var(--accent-soft), transparent 70%);
        pointer-events: none;
      }

      .cat:hover {
        transform: translate(-3px, -3px);
        box-shadow: 7px 7px 0 var(--ink);
        background: var(--accent-soft);
      }

      .cat-emoji {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: var(--ink);
        color: var(--paper);
        display: grid;
        place-items: center;
        font-size: 1.4rem;
        margin-bottom: 14px;
        border: 1.5px solid var(--ink);
        box-shadow: 2px 2px 0 var(--accent-deep);
        position: relative;
        z-index: 1;
      }

      .cat h3 {
        margin: 0 0 8px;
        font-size: 1.2rem;
        font-weight: 900;
        position: relative;
        z-index: 1;
      }

      .cat p {
        margin: 0;
        color: var(--muted);
        font-size: 0.93rem;
        position: relative;
        z-index: 1;
      }

      /* ===== Posts ===== */
      .posts {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
      }

      @media (max-width: 900px) {
        .posts {
          grid-template-columns: 1fr;
        }
      }

      .post {
        background: var(--card);
        border: 1.5px solid var(--ink);
        border-radius: 20px;
        padding: 24px 22px;
        display: flex;
        flex-direction: column;
        gap: 14px;
        box-shadow: 5px 5px 0 var(--ink);
        transition: transform 0.18s ease, box-shadow 0.18s ease;
      }

      .post:hover {
        transform: translate(-3px, -3px);
        box-shadow: 8px 8px 0 var(--ink);
      }

      .post-badge {
        align-self: flex-start;
        background: var(--accent-soft);
        border: 1.5px solid var(--ink);
        color: var(--ink);
        font-weight: 800;
        font-size: 0.78rem;
        padding: 5px 10px;
        border-radius: 999px;
      }

      .post h3 {
        margin: 0;
        font-size: 1.25rem;
        line-height: 1.5;
        font-weight: 900;
      }

      .post p {
        margin: 0;
        color: var(--muted);
        font-size: 0.96rem;
        flex: 1;
      }

      .post-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 10px;
        border-top: 1px dashed rgba(34, 33, 28, 0.25);
        font-size: 0.85rem;
        color: var(--muted);
        font-weight: 600;
      }

      .post-meta .read-link {
        text-decoration: none;
        color: var(--ink);
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-weight: 800;
      }

      .post-meta .read-link::before {
        content: "بخوانید";
      }

      .post-meta .read-link .arrow {
        transition: transform 0.2s ease;
        transform: scaleX(-1);
      }

      .post-meta .read-link:hover .arrow {
        transform: scaleX(-1) translateX(4px);
      }

      .post-meta .read-link.is-disabled {
        color: var(--muted);
        cursor: default;
      }

      .post-meta .read-link.is-disabled::before {
        content: "به‌زودی";
      }

      .posts-intro {
        margin: 0 0 28px;
        color: var(--muted);
        max-width: 70ch;
      }

      /* ===== Footer ===== */
      footer {
        border-top: 1px dashed rgba(34, 33, 28, 0.25);
        margin-top: 40px;
        padding: 42px 0 30px;
        position: relative;
        z-index: 1;
      }

      .foot-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 30px;
      }

      @media (max-width: 820px) {
        .foot-grid {
          grid-template-columns: 1fr;
        }
      }

      .foot-brand p {
        color: var(--muted);
        margin: 12px 0 0;
        max-width: 42ch;
        font-size: 0.95rem;
      }

      .foot h4 {
        margin: 0 0 14px;
        font-size: 1rem;
        font-weight: 900;
      }

      .foot ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 10px;
      }

      .foot a {
        text-decoration: none;
        color: var(--ink-soft);
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.95rem;
        transition: color 0.15s ease;
      }

      .foot a:hover {
        color: var(--accent-deep);
      }

      .social {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 16px;
      }

      .social a {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 14px;
        background: var(--card);
        border: 1.5px solid var(--ink);
        border-radius: 12px;
        box-shadow: 2px 2px 0 var(--ink);
        font-weight: 800;
        color: var(--ink);
        text-decoration: none;
        transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
        font-size: 0.88rem;
      }

      .social a:hover {
        transform: translate(-2px, -2px);
        box-shadow: 4px 4px 0 var(--ink);
        background: var(--accent-soft);
        color: var(--ink);
      }

      .copy {
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px dashed rgba(34, 33, 28, 0.2);
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: center;
        justify-content: space-between;
        color: var(--muted);
        font-size: 0.85rem;
        font-weight: 600;
      }

      .copy a {
        color: var(--ink-soft);
        text-decoration: none;
      }

      /* ===== Editorial redesign ===== */
      :root {
        --paper: #f4f7f2;
        --paper-2: #e7eee8;
        --ink: #17211e;
        --ink-soft: #25332f;
        --muted: #69766f;
        --line: #cfd9d1;
        --accent: #2f6f73;
        --accent-deep: #1f5558;
        --accent-soft: #e0eff0;
        --secondary: #9b3d4a;
        --secondary-soft: #f3e1e5;
        --gold: #c9932c;
        --card: #ffffff;
        --shadow: 0 18px 55px -44px rgba(23, 33, 30, 0.55);
      }

      body {
        background:
          linear-gradient(180deg, rgba(244, 247, 242, 0.96), rgba(231, 238, 232, 0.82)),
          var(--paper);
        color: var(--ink);
      }

      .noise::after {
        background-image:
          linear-gradient(rgba(47, 111, 115, 0.045) 1px, transparent 1px),
          linear-gradient(90deg, rgba(47, 111, 115, 0.035) 1px, transparent 1px);
        background-size: 44px 44px;
        opacity: 1;
        mix-blend-mode: normal;
      }

      header.nav {
        background: rgba(244, 247, 242, 0.9);
        border-bottom: 1px solid rgba(23, 33, 30, 0.1);
      }

      .nav-inner {
        padding: 18px 0;
      }

      .brand-logo {
        border: 1px solid rgba(23, 33, 30, 0.22);
        box-shadow: none;
      }

      .brand-title strong {
        letter-spacing: 0;
      }

      .brand-title span {
        color: var(--accent-deep);
      }

      .social-nav {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
        margin: 0;
        padding: 0;
      }

      .social-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        border: 1px solid rgba(47, 111, 115, 0.26);
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.62);
        color: var(--ink);
        box-shadow: none;
        font-size: 0.88rem;
        font-weight: 800;
        text-decoration: none;
        transition: border-color 0.16s ease, color 0.16s ease, background 0.16s ease;
      }

      .social-link:hover {
        background: var(--accent-soft);
        border-color: var(--accent);
        color: var(--accent-deep);
      }

      .hero {
        padding: 86px 0 64px;
      }

      .hero-grid {
        grid-template-columns: minmax(0, 1.08fr) minmax(260px, 0.72fr);
        gap: 70px;
      }

      .eyebrow {
        background: transparent;
        border: 0;
        border-radius: 0;
        border-inline-start: 4px solid var(--secondary);
        box-shadow: none;
        color: var(--secondary);
        padding: 3px 12px 3px 0;
      }

      .eyebrow::before {
        content: "";
      }

      h1 {
        color: var(--ink);
        letter-spacing: 0;
      }

      h1 .accent {
        background:
          linear-gradient(180deg, transparent 58%, rgba(47, 111, 115, 0.22) 58% 88%, transparent 88%);
      }

      .tagline {
        color: var(--accent-deep);
      }

      .lede {
        color: var(--muted);
        font-size: 1.05rem;
      }

      .hero-art .stamp {
        width: min(340px, 76vw);
      }

      .hero-art img {
        border: 1px solid rgba(23, 33, 30, 0.16);
        border-radius: 28px;
        box-shadow: var(--shadow);
      }

      .hero-art .dot {
        background: var(--card);
        border: 1px solid rgba(47, 111, 115, 0.26);
        border-radius: 10px;
        box-shadow: 0 14px 34px -24px rgba(23, 33, 30, 0.55);
      }

      .hero-art .sticker {
        background: var(--ink);
        border: 0;
        border-radius: 8px;
        color: #fff;
        box-shadow: none;
      }

      .section-kicker {
        color: var(--secondary);
        letter-spacing: 0;
      }

      h2 {
        letter-spacing: 0;
      }

      .cat,
      .post {
        border: 1px solid rgba(23, 33, 30, 0.1);
        border-radius: 8px;
        box-shadow: var(--shadow);
      }

      .cat::before {
        background: linear-gradient(135deg, rgba(47, 111, 115, 0.12), rgba(155, 61, 74, 0.09));
        border-radius: 999px;
      }

      .cat:hover,
      .post:hover {
        background: #fff;
        box-shadow: 0 22px 55px -42px rgba(23, 33, 30, 0.7);
        transform: translateY(-2px);
      }

      .cat-emoji {
        background: var(--accent-deep);
        border: 0;
        border-radius: 8px;
        box-shadow: none;
      }

      .post-badge {
        background: var(--secondary-soft);
        border: 0;
        border-radius: 7px;
        color: var(--secondary);
      }

      .post-meta {
        border-top: 1px solid var(--line);
      }

      .post-meta .read-link {
        color: var(--accent-deep);
      }

      footer {
        background: rgba(231, 238, 232, 0.62);
        border-top: 1px solid rgba(23, 33, 30, 0.1);
      }

      @media (max-width: 900px) {
        .hero-grid {
          grid-template-columns: 1fr;
          gap: 28px;
        }

        .hero-art {
          justify-content: flex-start;
        }

        .categories {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .posts {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 760px) {
        .nav-inner {
          align-items: flex-start;
          flex-direction: column;
          gap: 12px;
        }

        .social-nav {
          justify-content: flex-start;
          width: 100%;
        }

        .hero {
          padding: 40px 0 32px;
        }

        .hero-art .sticker {
          left: 6%;
          top: 8%;
        }
      }

      @media (max-width: 520px) {
        .container {
          width: min(1120px, calc(100% - 1.25rem));
        }

        .brand-title span {
          max-width: 42ch;
        }

        .social-link {
          font-size: 0.8rem;
          padding: 7px 10px;
        }

        .hero-art .stamp {
          width: min(260px, 82vw);
        }

        .hero-art .dot {
          width: 38px;
          height: 38px;
          font-size: 0.95rem;
        }

        .hero-art .sticker {
          font-size: 0.72rem;
          padding: 6px 10px;
        }

        section {
          padding: 36px 0;
        }

        .categories {
          grid-template-columns: 1fr;
        }

        .post-meta {
          flex-wrap: wrap;
          gap: 8px;
        }

        .copy {
          flex-direction: column;
          align-items: flex-start;
        }
      }
    </style>
  </head>
  <body class="noise">
    <header class="nav">
      <div class="container">
        <div class="nav-inner">
          <a href="/" class="brand" aria-label="صفحه اصلی بازفکر">
            <img class="brand-logo" src="/logo.jpg" alt="لوگوی بازفکر" />
            <span class="brand-title">
              <strong>بازفکر</strong>
              <span>چیزهای آشنا، از زاویه‌ای ناآشنا</span>
            </span>
          </a>
          <nav aria-label="شبکه‌های اجتماعی و ارتباط با ما">
            <ul class="social-nav">
              <li>
                <a
                  class="social-link"
                  href="https://t.me/bazfekr_support"
                  target="_blank"
                  rel="noopener"
                >
                  💬 تماس با ما
                </a>
              </li>
              <li>
                <a
                  class="social-link"
                  href="https://www.youtube.com/@bazfekr_channel"
                  target="_blank"
                  rel="noopener"
                >
                  🎥 یوتیوب
                </a>
              </li>
              <li>
                <a
                  class="social-link"
                  href="https://www.instagram.com/bazfekr_channel"
                  target="_blank"
                  rel="noopener"
                >
                  📷 اینستاگرام
                </a>
              </li>
            </ul>
          </nav>
        </div>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section class="hero">
        <div class="container">
          <div class="hero-grid">
            <div>
              <span class="eyebrow">چیزی که فکرش را می‌کنید، احتمالاً درست نیست</span>
              <h1>
                به <span class="accent">بازفکر</span> خوش آمدید؛
                <br />
                فکر کردن، با کمی تردید.
              </h1>
              <p class="tagline">{tagline}</p>
              <p class="lede">
                {description}
                در بازفکر، عاطفه، حقیقت و حس خوب حرف زدن را کنار هم می‌گذاریم؛
                از جاهای که همه عبور می‌کنند، توقف می‌کنیم و دوباره می‌نگریم.
              </p>
            </div>

            <div class="hero-art">
              <div class="stamp">
                <img src="/logo.jpg" alt="لوگوی بازفکر؛ سرِ بازِ آدم با لامپ روشن ایده" />
                <div class="dot d1" aria-hidden="true">💡</div>
                <div class="dot d2" aria-hidden="true">🧠</div>
                <div class="sticker">تازه تأسیس · ۱۴۰۵</div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Categories -->
      <section id="categories">
        <div class="container">
          <div class="section-head">
            <div>
              <div class="section-kicker">/// دسته‌بندی مطالب</div>
              <h2>از کدام زاویه می‌خواهید نگاه کنید؟</h2>
            </div>
            <p>
              هر هفته در یکی از این چهار دسته، مطلبی منتشر می‌شود. شاید بتوانید
              از همان دسته‌ای که کمتر علاقه‌مندید شروع کنید؛ گاهی بهترین فکرها
              از جایی می‌آیند که اصلاً انتظارشان را نداریم.
            </p>
          </div>

          <div class="categories">
            {categories.map((c) => (
              <article class="cat">
                <div class="cat-emoji" aria-hidden="true">{c.emoji}</div>
                <h3>{c.title}</h3>
                <p>{c.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- Featured Posts -->
      <section id="posts">
        <div class="container">
          <p class="posts-intro">
            تازه‌ترین مقاله‌های بازفکر همین‌جا منتشر شده‌اند؛
            نسخه‌ی کامل مطالب تازه را در همین صفحه و در کانال تلگرام بازفکر
            منتشر می‌کنیم.
          </p>

          <div class="posts">
            {featuredPosts.map((p) => (
              <article class="post">
                <span class="post-badge">{p.badge}</span>
                <h3>{p.title}</h3>
                <p>{p.excerpt}</p>
                <div class="post-meta">
                  <span>⏱ حدود {p.minutes} دقیقه خوانش</span>
                  {
                    p.href ? (
                      <a href={p.href} class="read-link" aria-label={`ادامه مطلب: ${p.title}`}>
                        <span class="arrow" aria-hidden="true">→</span>
                      </a>
                    ) : (
                      <span class="read-link is-disabled" aria-label="به‌زودی">
                        <span class="arrow" aria-hidden="true">→</span>
                      </span>
                    )
                  }
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

    </main>

    <!-- Footer -->
    <footer id="contact">
      <div class="container foot-grid">
        <div class="foot-brand">
          <a href="/" class="brand" aria-label="بازگشت به صفحه اصلی">
            <img class="brand-logo" src="/logo.jpg" alt="لوگوی بازفکر" />
            <span class="brand-title">
              <strong>بازفکر</strong>
              <span>Bazfekr · بازفکر کردن، هنرِ تردید</span>
            </span>
          </a>
        </div>
      </div>

      <div class="container copy">
        <div>© {new Date().getFullYear()} بازفکر — بازفکر کردن؛ آزادانه و با تردید.</div>
        <div>
          ساخته‌شده با ❤ در ایران · <a href={siteUrl}>www.bazfekr.ir</a>
        </div>
      </div>
    </footer>
  </body>
</html>
