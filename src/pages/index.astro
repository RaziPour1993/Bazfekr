---
const siteTitle = "بازفکر | Bazfekr";
const tagline = "چیزهای آشنا، از زاویه‌ای ناآشنا";
const description =
  "بازفکر؛ فضایی برای کاوش در اقتصاد، رفتار و تصمیم‌های انسانی؛ و چیزهای دیگری که آن‌گونه که فکر می‌کنیم نیستند.";
const siteUrl = "https://www.bazfekr.ir";

const categories = [
  {
    title: "اقتصاد",
    description: "مفاهیم اقتصادی؛ نه آن‌گونه که در کتاب‌های درسی می‌آموزیم، بلکه آن‌گونه که در زندگی واقعی تجربه می‌کنیم.",
    emoji: "📈",
  },
  {
    title: "رفتار انسانی",
    description: "چرا افراد تصمیم‌های عجیب می‌گیرند؟ چیزی که روان‌شناسی و علوم شناختی درباره‌ی ما فاش می‌کند.",
    emoji: "🧠",
  },
  {
    title: "تصمیم‌گیری",
    description: "هنر انتخابِ هوشمندانه؛ میان تورش‌های ذهنی، قیود واقعیت و رویاهای بلندمدت.",
    emoji: "🎯",
  },
  {
    title: "چیزهایی که… نیستند",
    description: "همان چیزهایی که «همه می‌دانند» ولی در واقع هیچ‌کس آن‌ها را نمی‌داند؛ یا دروغ‌های آشکاری را به‌عنوان حقیقت می‌پذیرند.",
    emoji: "🔍",
  },
];

const featuredPosts = [
  {
    badge: "اقتصاد",
    title: "چرا قیمت‌ها هرگز آن‌طور که فکر می‌کنیم معقول نیستند؟",
    excerpt:
      "نرخ تورم، قیمت مسکن، ارز و سهام؛ همه چیزی که درباره‌ی تعیین قیمت فکر می‌کنیم دچار چند تورش شناختی ریشه‌ای است که از نوجوانی در ذهن ما جا خوش کرده‌اند.",
    minutes: 7,
  },
  {
    badge: "رفتار",
    title: "اثر غریبه: چرا از دیدن کسی که مثل ما نیست، ناراحت می‌شویم؟",
    excerpt:
      "تجربه‌ی هوشمندانه‌ی یک فروشنده‌ی خیابانی در اصفهان، درست مثل مطالعات ۲۰ ساله‌ی محققان دانشگاه شیکاگو، توضیح می‌دهد چرا مغز ما عاشق «آشنا» است و از «ناآشنا» می‌ترسد.",
    minutes: 9,
  },
  {
    badge: "تصمیم‌گیری",
    title: "قاعده‌ی ۱۰ دقیقه‌ای که هزاران تصمیم غلط را از من گرفت",
    excerpt:
      "یک قانون ساده و کوچک که اگر قبل از هر تصمیم مهم و بی‌اهمیت به خاطر بسپارید، به اندازه‌ی یک دانشگاه کامل از شما دفاع می‌کند؛ بدون اینکه نیاز به هیچ مدرکی داشته باشد.",
    minutes: 5,
  },
];
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={siteUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="بازفکر" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content="/logo.jpg" />
    <meta property="og:locale" content="fa_IR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/logo.jpg" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.jpg" />

    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css"
      rel="stylesheet"
      type="text/css"
    />

    <style>
      :root {
        --paper: #fbf6e9;
        --paper-2: #f3ead3;
        --ink: #141413;
        --ink-soft: #2a2924;
        --muted: #6b685c;
        --line: #22211c;
        --accent: #f4b400;
        --accent-deep: #c78b00;
        --accent-soft: #fff3c6;
        --card: #fffdf6;
        --shadow: 0 1px 0 #000, 0 10px 30px -20px rgba(20, 20, 19, 0.35);
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
      }

      body {
        font-family:
          "Vazirmatn",
          system-ui,
          -apple-system,
          "Segoe UI",
          Roboto,
          sans-serif;
        background:
          radial-gradient(1200px 500px at 90% -10%, #fff3c633, transparent 60%),
          radial-gradient(900px 500px at -10% 100%, #f4b40022, transparent 60%),
          var(--paper);
        color: var(--ink);
        line-height: 1.8;
        font-feature-settings: "ss01", "ss02";
        min-height: 100vh;
      }

      .noise::after {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        background-image: radial-gradient(rgba(20, 20, 19, 0.06) 1px, transparent 1px);
        background-size: 3px 3px;
        opacity: 0.6;
        mix-blend-mode: multiply;
        z-index: 0;
      }

      .container {
        width: min(1120px, 92vw);
        margin: 0 auto;
        position: relative;
        z-index: 1;
      }

      /* ===== Header ===== */
      header.nav {
        position: sticky;
        top: 0;
        z-index: 20;
        backdrop-filter: blur(8px);
        background: rgba(251, 246, 233, 0.78);
        border-bottom: 1px dashed rgba(34, 33, 28, 0.18);
      }

      .nav-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 14px 0;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        color: var(--ink);
      }

      .brand-logo {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        object-fit: cover;
        border: 1.5px solid var(--ink);
        box-shadow: 2px 2px 0 var(--ink);
      }

      .brand-title {
        display: flex;
        flex-direction: column;
        line-height: 1.1;
      }

      .brand-title strong {
        font-size: 1.15rem;
        font-weight: 800;
        letter-spacing: -0.01em;
      }

      .brand-title span {
        font-size: 0.78rem;
        color: var(--muted);
      }

      nav ul {
        list-style: none;
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0;
        padding: 0;
        flex-wrap: wrap;
      }

      nav a {
        display: inline-block;
        text-decoration: none;
        color: var(--ink-soft);
        font-weight: 600;
        padding: 8px 14px;
        border-radius: 999px;
        font-size: 0.95rem;
        transition: all 0.15s ease;
      }

      nav a:hover {
        background: var(--accent-soft);
        color: var(--ink);
      }

      nav a.cta {
        background: var(--ink);
        color: var(--paper);
        padding: 9px 16px;
        border: 1.5px solid var(--ink);
      }

      nav a.cta:hover {
        background: var(--accent-deep);
        border-color: var(--accent-deep);
        transform: translateY(-1px);
      }

      /* ===== Hero ===== */
      .hero {
        padding: 72px 0 56px;
        position: relative;
      }

      .hero-grid {
        display: grid;
        grid-template-columns: 1.15fr 0.85fr;
        align-items: center;
        gap: 56px;
      }

      @media (max-width: 900px) {
        .hero-grid {
          grid-template-columns: 1fr;
          gap: 36px;
        }
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: var(--accent-soft);
        border: 1.5px solid var(--ink);
        color: var(--ink);
        padding: 6px 14px;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 700;
        box-shadow: 2px 2px 0 var(--ink);
      }

      .eyebrow::before {
        content: "✦";
        color: var(--accent-deep);
      }

      h1 {
        font-size: clamp(2.2rem, 4.5vw, 3.4rem);
        font-weight: 900;
        line-height: 1.15;
        margin: 20px 0 18px;
        letter-spacing: -0.02em;
      }

      h1 .accent {
        background:
          linear-gradient(180deg, transparent 65%, var(--accent) 65% 92%, transparent 92%);
        padding: 0 2px;
      }

      .tagline {
        font-size: clamp(1.05rem, 1.8vw, 1.35rem);
        font-weight: 700;
        color: var(--ink-soft);
        margin: 0 0 14px;
      }

      .lede {
        font-size: 1.02rem;
        color: var(--muted);
        max-width: 55ch;
        margin: 0 0 28px;
      }

      .hero-art {
        position: relative;
        display: flex;
        justify-content: center;
      }

      .hero-art .stamp {
        position: relative;
        width: min(380px, 85vw);
        aspect-ratio: 1 / 1;
      }

      .hero-art img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 50%;
        border: 2.5px solid var(--ink);
        box-shadow:
          6px 6px 0 var(--ink),
          0 20px 50px -20px rgba(0, 0, 0, 0.35);
        background: var(--paper-2);
      }

      .hero-art .dot {
        position: absolute;
        width: 46px;
        height: 46px;
        background: var(--accent);
        border: 1.5px solid var(--ink);
        border-radius: 50%;
        box-shadow: 3px 3px 0 var(--ink);
        display: grid;
        place-items: center;
        font-size: 1.1rem;
      }

      .hero-art .dot.d1 {
        top: -6%;
        right: -2%;
        animation: floatY 4s ease-in-out infinite;
      }

      .hero-art .dot.d2 {
        bottom: 4%;
        left: -4%;
        animation: floatY 5s ease-in-out infinite reverse;
      }

      .hero-art .sticker {
        position: absolute;
        padding: 8px 14px;
        background: var(--card);
        border: 1.5px solid var(--ink);
        border-radius: 12px;
        font-weight: 800;
        font-size: 0.82rem;
        box-shadow: 3px 3px 0 var(--ink);
        transform: rotate(-4deg);
        left: -10%;
        top: 18%;
      }

      @keyframes floatY {
        0%,
        100% {
          transform: translateY(0);
        }
        50% {
          transform: translateY(-10px);
        }
      }

      /* ===== Section shell ===== */
      section {
        padding: 56px 0;
        position: relative;
        z-index: 1;
      }

      .section-head {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
        flex-wrap: wrap;
      }

      .section-kicker {
        color: var(--accent-deep);
        font-weight: 800;
        font-size: 0.88rem;
        letter-spacing: 0.04em;
      }

      h2 {
        font-size: clamp(1.7rem, 3vw, 2.3rem);
        margin: 6px 0 0;
        font-weight: 900;
        letter-spacing: -0.01em;
      }

      .section-head p {
        margin: 0;
        color: var(--muted);
        max-width: 48ch;
      }

      /* ===== Categories ===== */
      .categories {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
      }

      @media (max-width: 900px) {
        .categories {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (max-width: 520px) {
        .categories {
          grid-template-columns: 1fr;
        }
      }

      .cat {
        background: var(--card);
        border: 1.5px solid var(--ink);
        border-radius: 18px;
        padding: 22px 20px;
        box-shadow: 4px 4px 0 var(--ink);
        transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
        position: relative;
        overflow: hidden;
      }

      .cat::before {
        content: "";
        position: absolute;
        inset: auto -20% -60% auto;
        width: 220px;
        height: 220px;
        background: radial-gradient(circle, var(--accent-soft), transparent 70%);
        pointer-events: none;
      }

      .cat:hover {
        transform: translate(-3px, -3px);
        box-shadow: 7px 7px 0 var(--ink);
        background: var(--accent-soft);
      }

      .cat-emoji {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: var(--ink);
        color: var(--paper);
        display: grid;
        place-items: center;
        font-size: 1.4rem;
        margin-bottom: 14px;
        border: 1.5px solid var(--ink);
        box-shadow: 2px 2px 0 var(--accent-deep);
        position: relative;
        z-index: 1;
      }

      .cat h3 {
        margin: 0 0 8px;
        font-size: 1.2rem;
        font-weight: 900;
        position: relative;
        z-index: 1;
      }

      .cat p {
        margin: 0;
        color: var(--muted);
        font-size: 0.93rem;
        position: relative;
        z-index: 1;
      }

      /* ===== Posts ===== */
      .posts {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
      }

      @media (max-width: 900px) {
        .posts {
          grid-template-columns: 1fr;
        }
      }

      .post {
        background: var(--card);
        border: 1.5px solid var(--ink);
        border-radius: 20px;
        padding: 24px 22px;
        display: flex;
        flex-direction: column;
        gap: 14px;
        box-shadow: 5px 5px 0 var(--ink);
        transition: transform 0.18s ease, box-shadow 0.18s ease;
      }

      .post:hover {
        transform: translate(-3px, -3px);
        box-shadow: 8px 8px 0 var(--ink);
      }

      .post-badge {
        align-self: flex-start;
        background: var(--accent-soft);
        border: 1.5px solid var(--ink);
        color: var(--ink);
        font-weight: 800;
        font-size: 0.78rem;
        padding: 5px 10px;
        border-radius: 999px;
      }

      .post h3 {
        margin: 0;
        font-size: 1.25rem;
        line-height: 1.5;
        font-weight: 900;
      }

      .post p {
        margin: 0;
        color: var(--muted);
        font-size: 0.96rem;
        flex: 1;
      }

      .post-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 10px;
        border-top: 1px dashed rgba(34, 33, 28, 0.25);
        font-size: 0.85rem;
        color: var(--muted);
        font-weight: 600;
      }

      .post-meta .read-link {
        text-decoration: none;
        color: var(--ink);
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-weight: 800;
      }

      .post-meta .read-link::before {
        content: "بخوانید";
      }

      .post-meta .read-link .arrow {
        transition: transform 0.2s ease;
        transform: scaleX(-1);
      }

      .post-meta .read-link:hover .arrow {
        transform: scaleX(-1) translateX(4px);
      }

      /* ===== Footer ===== */
      footer {
        border-top: 1px dashed rgba(34, 33, 28, 0.25);
        margin-top: 40px;
        padding: 42px 0 30px;
        position: relative;
        z-index: 1;
      }

      .foot-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 30px;
      }

      @media (max-width: 820px) {
        .foot-grid {
          grid-template-columns: 1fr;
        }
      }

      .foot-brand p {
        color: var(--muted);
        margin: 12px 0 0;
        max-width: 42ch;
        font-size: 0.95rem;
      }

      .foot h4 {
        margin: 0 0 14px;
        font-size: 1rem;
        font-weight: 900;
      }

      .foot ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 10px;
      }

      .foot a {
        text-decoration: none;
        color: var(--ink-soft);
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.95rem;
        transition: color 0.15s ease;
      }

      .foot a:hover {
        color: var(--accent-deep);
      }

      .social {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 16px;
      }

      .social a {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 14px;
        background: var(--card);
        border: 1.5px solid var(--ink);
        border-radius: 12px;
        box-shadow: 2px 2px 0 var(--ink);
        font-weight: 800;
        color: var(--ink);
        text-decoration: none;
        transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
        font-size: 0.88rem;
      }

      .social a:hover {
        transform: translate(-2px, -2px);
        box-shadow: 4px 4px 0 var(--ink);
        background: var(--accent-soft);
        color: var(--ink);
      }

      .copy {
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px dashed rgba(34, 33, 28, 0.2);
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: center;
        justify-content: space-between;
        color: var(--muted);
        font-size: 0.85rem;
        font-weight: 600;
      }

      .copy a {
        color: var(--ink-soft);
        text-decoration: none;
      }
    </style>
  </head>
  <body class="noise">
    <header class="nav">
      <div class="container">
        <div class="nav-inner">
          <a href="/" class="brand" aria-label="صفحه اصلی بازفکر">
            <img class="brand-logo" src="/logo.jpg" alt="لوگوی بازفکر" />
            <span class="brand-title">
              <strong>بازفکر</strong>
              <span>چیزهای آشنا، از زاویه‌ای ناآشنا</span>
            </span>
          </a>
          <nav aria-label="شبکه‌های اجتماعی و ارتباط با ما">
            <ul
              style="list-style: none; display: grid; grid-template-columns: repeat(2, auto); gap: 10px; margin: 0; padding: 0;"
            >
