                  style="display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px; background: var(--card); border: 1.5px solid var(--ink); border-radius: 12px; box-shadow: 2px 2px 0 var(--ink); font-weight: 800; color: var(--ink); text-decoration: none; transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease, border-color 0.15s ease; font-size: 0.88rem;"
                  onmouseover="this.style.transform='translate(-2px,-2px)'; this.style.boxShadow='4px 4px 0 var(--ink)'; this.style.background='var(--accent-soft)';"
                  onmouseout="this.style.transform=''; this.style.boxShadow='2px 2px 0 var(--ink)'; this.style.background='var(--card)';"
                >
                  🎥 یوتیوب
                </a>
              </li>
              <li>
                <a
                  href="https://www.instagram.com/bazfekr_channel"
                  target="_blank"
                  rel="noopener"
                  style="display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px; background: var(--card); border: 1.5px solid var(--ink); border-radius: 12px; box-shadow: 2px 2px 0 var(--ink); font-weight: 800; color: var(--ink); text-decoration: none; transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease, border-color 0.15s ease; font-size: 0.88rem;"
                  onmouseover="this.style.transform='translate(-2px,-2px)'; this.style.boxShadow='4px 4px 0 var(--ink)'; this.style.background='var(--accent-soft)';"
                  onmouseout="this.style.transform=''; this.style.boxShadow='2px 2px 0 var(--ink)'; this.style.background='var(--card)';"
                >
                  📷 اینستاگرام
                </a>
              </li>
            </ul>
          </nav>
        </div>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section class="hero">
        <div class="container">
          <div class="hero-grid">
            <div>
              <span class="eyebrow">چیزی که فکرش را می‌کنید، احتمالاً درست نیست</span>
              <h1>
                به <span class="accent">بازفکر</span> خوش آمدید؛
                <br />
                فکر کردن، با کمی تردید.
              </h1>
              <p class="tagline">{tagline}</p>
              <p class="lede">
                {description}
                در بازفکر، عاطفه، حقیقت و حس خوب حرف زدن را کنار هم می‌گذاریم؛
                از جاهای که همه عبور می‌کنند، توقف می‌کنیم و دوباره می‌نگریم.
              </p>
            </div>

            <div class="hero-art">
              <div class="stamp">
                <img src="/logo.jpg" alt="لوگوی بازفکر؛ سرِ بازِ آدم با لامپ روشن ایده" />
                <div class="dot d1" aria-hidden="true">💡</div>
                <div class="dot d2" aria-hidden="true">🧠</div>
                <div class="sticker">تازه تأسیس · ۱۴۰۵</div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Categories -->
      <section id="categories">
        <div class="container">
          <div class="section-head">
            <div>
              <div class="section-kicker">/// دسته‌بندی مطالب</div>
              <h2>از کدام زاویه می‌خواهید نگاه کنید؟</h2>
            </div>
            <p>
              هر هفته در یکی از این چهار دسته، مطلبی منتشر می‌شود. شاید بتوانید
              از همان دسته‌ای که کمتر علاقه‌مندید شروع کنید؛ گاهی بهترین فکرها
              از جایی می‌آیند که اصلاً انتظارشان را نداریم.
            </p>
          </div>

          <div class="categories">
            {categories.map((c) => (
              <article class="cat">
                <div class="cat-emoji" aria-hidden="true">{c.emoji}</div>
                <h3>{c.title}</h3>
                <p>{c.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- Featured Posts -->
      <section id="posts">
        <div class="container">
          <p style="margin: 0 0 28px; color: var(--muted); max-width: 70ch;">
            این‌ها متنی هستند که در صف انتشار هستند؛ بزودی نسخه‌ی کاملشان را
            در همین صفحه و در کانال تلگرام بازفکر منتشر می‌کنیم.
          </p>

          <div class="posts">
            {featuredPosts.map((p) => (
              <article class="post">
                <span class="post-badge">{p.badge}</span>
                <h3>{p.title}</h3>
                <p>{p.excerpt}</p>
                <div class="post-meta">
                  <span>⏱ حدود {p.minutes} دقیقه خوانش</span>
                  <a href="#" class="read-link" aria-label="ادامه مطلب">
                    <span class="arrow" aria-hidden="true">→</span>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

    </main>

    <!-- Footer -->
    <footer id="contact">
      <div class="container foot-grid">
        <div class="foot-brand">
          <a href="/" class="brand" aria-label="بازگشت به صفحه اصلی">
            <img class="brand-logo" src="/logo.jpg" alt="لوگوی بازفکر" />
            <span class="brand-title">
              <strong>بازفکر</strong>
              <span>Bazfekr · بازفکر کردن، هنرِ تردید</span>
            </span>
          </a>

          <div class="social" aria-label="شبکه‌های اجتماعی بازفکر">
            <a href="https://t.me/bazfekr_channel" target="_blank" rel="noopener">
              ✈️ کانال تلگرام
            </a>
            <a href="https://t.me/bazfekr_support" target="_blank" rel="noopener">
              💬 پشتیبانی تلگرام
            </a>
            <a
              href="https://www.instagram.com/bazfekr_channel"
              target="_blank"
              rel="noopener"
            >
              📷 اینستاگرام
            </a>
            <a
              href="https://www.youtube.com/@bazfekr_channel"
              target="_blank"
              rel="noopener"
            >
              🎥 یوتیوب
            </a>
          </div>
        </div>
      </div>

      <div class="container copy">
        <div>© {new Date().getFullYear()} بازفکر — بازفکر کردن؛ آزادانه و با تردید.</div>
        <div>
          ساخته‌شده با ❤ در ایران · <a href={siteUrl}>www.bazfekr.ir</a>
        </div>
      </div>
    </footer>
  </body>
</html>
