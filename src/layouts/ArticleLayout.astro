---
const frontmatter = Astro.props.frontmatter ?? {};
const title = Astro.props.title ?? frontmatter.title;
const description = Astro.props.description ?? frontmatter.description;
const pubDate = Astro.props.pubDate ?? frontmatter.pubDate;
const category = Astro.props.category ?? frontmatter.category ?? "بازفکر";
const readTime = Astro.props.readTime ?? frontmatter.readTime;

const siteUrl = "https://www.bazfekr.ir";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const formattedDate = pubDate
  ? new Date(pubDate).toLocaleDateString("fa-IR", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : "";
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title} | بازفکر</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="بازفکر" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="/logo.jpg" />
    <meta property="og:locale" content="fa_IR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/logo.jpg" />

    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.jpg" />

    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link
      href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css"
      rel="stylesheet"
      type="text/css"
    />

    <style>
      :root {
        --paper: #fbf6e9;
        --paper-2: #f3ead3;
        --ink: #141413;
        --ink-soft: #2a2924;
        --muted: #6b685c;
        --accent: #f4b400;
        --accent-deep: #a87400;
        --accent-soft: #fff3c6;
        --card: #fffdf6;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
      }

      body {
        min-height: 100vh;
        background:
          radial-gradient(1200px 500px at 90% -10%, #fff3c633, transparent 60%),
          radial-gradient(900px 500px at -10% 100%, #f4b40022, transparent 60%),
          var(--paper);
        color: var(--ink);
        font-family:
          "Vazirmatn",
          system-ui,
          -apple-system,
          "Segoe UI",
          Roboto,
          sans-serif;
        line-height: 1.9;
      }

      .noise::after {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        background-image: radial-gradient(rgba(20, 20, 19, 0.055) 1px, transparent 1px);
        background-size: 3px 3px;
        opacity: 0.55;
        mix-blend-mode: multiply;
        z-index: 0;
      }

      .container {
        width: min(860px, 92vw);
        margin: 0 auto;
        position: relative;
        z-index: 1;
      }

      .topbar {
        border-bottom: 1px dashed rgba(34, 33, 28, 0.2);
        background: rgba(251, 246, 233, 0.82);
        backdrop-filter: blur(8px);
        position: sticky;
        top: 0;
        z-index: 10;
      }

      .topbar-inner {
        width: min(1040px, 92vw);
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        padding: 14px 0;
      }

      .brand,
      .back-link {
        color: var(--ink);
        text-decoration: none;
        font-weight: 900;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
      }

      .brand img {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        border: 1.5px solid var(--ink);
        box-shadow: 2px 2px 0 var(--ink);
      }

      .back-link {
        padding: 8px 13px;
        border: 1.5px solid var(--ink);
        border-radius: 12px;
        background: var(--card);
        box-shadow: 2px 2px 0 var(--ink);
        font-size: 0.9rem;
      }

      .hero {
        padding: 66px 0 30px;
      }

      .meta {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
        color: var(--muted);
        font-weight: 800;
        font-size: 0.92rem;
        margin-bottom: 18px;
      }

      .pill {
        background: var(--accent-soft);
        border: 1.5px solid var(--ink);
        border-radius: 999px;
        color: var(--ink);
        padding: 5px 12px;
        box-shadow: 2px 2px 0 var(--ink);
      }

      h1 {
        margin: 0 0 18px;
        font-size: clamp(2rem, 5vw, 3.4rem);
        line-height: 1.25;
        font-weight: 950;
      }

      .description {
        margin: 0;
        color: var(--muted);
        font-size: 1.08rem;
        max-width: 68ch;
      }

      article {
        margin: 34px 0 70px;
        padding: 42px min(6vw, 54px);
        background: var(--card);
        border: 1.5px solid var(--ink);
        border-radius: 18px;
        box-shadow: 6px 6px 0 var(--ink);
      }

      article :global(h1:first-child) {
        display: none;
      }

      article :global(h1),
      article :global(h2),
      article :global(h3) {
        color: var(--ink);
        line-height: 1.45;
        font-weight: 950;
      }

      article :global(h1),
      article :global(h2) {
        margin: 2.4em 0 0.75em;
        font-size: clamp(1.45rem, 3.3vw, 2.15rem);
      }

      article :global(h3) {
        margin: 1.8em 0 0.5em;
        font-size: 1.18rem;
      }

      article :global(p),
      article :global(li) {
        color: var(--ink-soft);
        font-size: 1.03rem;
      }

      article :global(p) {
        margin: 0 0 1.1em;
      }

      article :global(ul),
      article :global(ol) {
        padding-inline-start: 1.4rem;
        margin: 0 0 1.4em;
      }

      article :global(li) {
        margin: 0.35em 0;
      }

      article :global(strong) {
        color: var(--ink);
        font-weight: 950;
      }

      article :global(blockquote) {
        margin: 1.7em 0;
        padding: 18px 22px;
        background: var(--accent-soft);
        border: 1.5px solid var(--ink);
        border-radius: 14px;
        box-shadow: 3px 3px 0 var(--ink);
      }

      article :global(blockquote p) {
        margin: 0;
        color: var(--ink);
        font-weight: 850;
      }

      article :global(hr) {
        border: 0;
        border-top: 1px dashed rgba(34, 33, 28, 0.28);
        margin: 2.4em 0;
      }

      article :global(a) {
        color: var(--accent-deep);
        font-weight: 850;
        text-decoration-thickness: 1px;
        text-underline-offset: 4px;
      }

      footer {
        border-top: 1px dashed rgba(34, 33, 28, 0.25);
        padding: 28px 0 34px;
        color: var(--muted);
        font-size: 0.9rem;
        font-weight: 700;
      }

      @media (max-width: 640px) {
        .topbar-inner {
          align-items: flex-start;
          flex-direction: column;
        }

        .hero {
          padding-top: 44px;
        }

        article {
          border-radius: 14px;
          padding: 28px 20px;
          box-shadow: 4px 4px 0 var(--ink);
        }
      }

      /* ===== Editorial redesign ===== */
      :root {
        --paper: #f4f7f2;
        --paper-2: #e7eee8;
        --ink: #17211e;
        --ink-soft: #25332f;
        --muted: #69766f;
        --accent: #2f6f73;
        --accent-deep: #1f5558;
        --accent-soft: #e0eff0;
        --secondary: #9b3d4a;
        --secondary-soft: #f3e1e5;
        --gold: #c9932c;
        --card: #ffffff;
        --line: #cfd9d1;
      }

      body {
        background:
          linear-gradient(180deg, rgba(244, 247, 242, 0.96), rgba(231, 238, 232, 0.86)),
          var(--paper);
      }

      .noise::after {
        background-image:
          linear-gradient(rgba(47, 111, 115, 0.045) 1px, transparent 1px),
          linear-gradient(90deg, rgba(47, 111, 115, 0.035) 1px, transparent 1px);
        background-size: 44px 44px;
        opacity: 1;
        mix-blend-mode: normal;
      }

      .topbar {
        background: rgba(244, 247, 242, 0.92);
        border-bottom: 1px solid rgba(23, 33, 30, 0.1);
      }

      .brand img {
        border: 1px solid rgba(23, 33, 30, 0.18);
        box-shadow: none;
      }

      .back-link {
        border: 1px solid rgba(47, 111, 115, 0.26);
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.62);
        box-shadow: none;
        color: var(--accent-deep);
      }

      .hero {
        padding: 76px 0 26px;
      }

      .meta {
        color: var(--muted);
      }

      .pill {
        background: var(--secondary-soft);
        border: 0;
        border-radius: 7px;
        box-shadow: none;
        color: var(--secondary);
      }

      h1 {
        letter-spacing: 0;
      }

      .description {
        border-inline-start: 4px solid var(--accent);
        color: var(--ink-soft);
        padding-inline-start: 16px;
      }

      article {
        background: rgba(255, 255, 255, 0.82);
        border: 1px solid rgba(23, 33, 30, 0.1);
        border-radius: 8px;
        box-shadow: 0 24px 70px -54px rgba(23, 33, 30, 0.62);
      }

      article :global(h2) {
        color: var(--accent-deep);
        border-top: 1px solid var(--line);
        padding-top: 1.05em;
      }

      article :global(h3) {
        color: var(--secondary);
      }

      article :global(blockquote) {
        background: var(--accent-soft);
        border: 0;
        border-inline-start: 4px solid var(--accent);
        border-radius: 8px;
        box-shadow: none;
      }

      article :global(a) {
        color: var(--secondary);
      }

      footer {
        background: rgba(231, 238, 232, 0.62);
        border-top: 1px solid rgba(23, 33, 30, 0.1);
      }

      @media (max-width: 640px) {
        article {
          box-shadow: 0 18px 50px -42px rgba(23, 33, 30, 0.6);
        }
      }
    </style>
  </head>
  <body class="noise">
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="/" aria-label="صفحه اصلی بازفکر">
          <img src="/logo.jpg" alt="لوگوی بازفکر" />
          <span>بازفکر</span>
        </a>
        <a class="back-link" href="/">بازگشت به صفحه اصلی</a>
      </div>
    </header>

    <main>
      <section class="container hero">
        <div class="meta">
          <span class="pill">{category}</span>
          {formattedDate && <span>{formattedDate}</span>}
          {readTime && <span>{readTime} خواندن</span>}
        </div>
        <h1>{title}</h1>
        <p class="description">{description}</p>
      </section>

      <article class="container">
        <slot />
      </article>
    </main>

    <footer>
      <div class="container">© {new Date().getFullYear()} بازفکر</div>
    </footer>
  </body>
</html>
